<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    bootstrap="tests/bootstrap.php"
    cacheDirectory=".phpunit.cache"
    >
    <testsuites>
        <testsuite name="seo">
            <directory>tests/TestCase/</directory>
        </testsuite>
    </testsuites>
</phpunit>
