{
    "name": "themusicdev/seo",
    "description": "CakePHP 5 plugin: page meta, structured data (JSON-LD), sitemap, robots.txt, and 301/410 redirects from one page index",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "seo", "sitemap", "robots.txt", "json-ld", "structured-data", "redirects", "canonical-url"],
    "homepage": "https://github.com/TheMusicDev/cakephp-seo",
    "license": "MIT",
    "authors": [
        {
            "name": "TheMusicDev",
            "homepage": "https://themusicdev.llc"
        }
    ],
    "support": {
        "issues": "https://github.com/TheMusicDev/cakephp-seo/issues",
        "source": "https://github.com/TheMusicDev/cakephp-seo"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2",
        "ext-xmlwriter": "*"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/migrations": "^5.0",
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
        "ramsey/conventional-commits": "^1.7"
    },
    "suggest": {
        "cakephp/migrations": "Needed to create the seo_pages and seo_redirects tables (bin/cake migrations migrate -p TheMusicDev/Seo)"
    },
    "autoload": {
        "psr-4": {
            "TheMusicDev\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheMusicDev\\Seo\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        },
        "sort-packages": true
    }
}
